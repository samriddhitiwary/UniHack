APP_NAME=CatalogIQ API
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

AWS_REGION=ap-south-1
DYNAMODB_ENDPOINT_URL=http://localhost:8001
DYNAMODB_TABLE_PREFIX=catalogiq-dev

STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=../../storage
S3_BUCKET_NAME=

CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_PDF_UPLOAD_BYTES=10485760
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_CSV_UPLOAD_BYTES=5242880
PDF_EXTRACTION_MAX_PAGES=300
PDF_EXTRACTION_MAX_TOTAL_CHARACTERS=2000000
PDF_EXTRACTION_MAX_PAGE_CHARACTERS=100000
PDF_TABLE_EXTRACTION_MAX_PAGES=300
PDF_TABLE_EXTRACTION_MAX_TABLES=500
PDF_TABLE_EXTRACTION_MAX_ROWS_PER_TABLE=5000
PDF_TABLE_EXTRACTION_MAX_COLUMNS_PER_TABLE=200
PDF_TABLE_EXTRACTION_MAX_CELLS=500000
PDF_TABLE_EXTRACTION_MAX_CELL_CHARACTERS=20000
CSV_PROCESSING_MAX_FILE_BYTES=5242880
CSV_PROCESSING_MAX_ROWS=100000
CSV_PROCESSING_MAX_COLUMNS=500
CSV_PROCESSING_MAX_TOTAL_CELLS=1000000
CSV_PROCESSING_MAX_CELL_CHARACTERS=50000
CSV_PROCESSING_SAMPLE_BYTES=65536
IMAGE_ANALYSIS_MAX_FILE_BYTES=10485760
IMAGE_ANALYSIS_MAX_WIDTH=12000
IMAGE_ANALYSIS_MAX_HEIGHT=12000
IMAGE_ANALYSIS_MAX_PIXELS=80000000
IMAGE_ANALYSIS_MAX_REGIONS=16
IMAGE_OCR_MAX_REGIONS=6
IMAGE_OCR_MAX_BLOCKS=5000
IMAGE_OCR_MAX_TOTAL_CHARACTERS=500000
IMAGE_OCR_MAX_BLOCK_CHARACTERS=10000
IMAGE_OCR_MIN_CONFIDENCE_BP=4000
LOG_LEVEL=INFO
